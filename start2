#!/bin/bash

# ========== Warna ==========
green="\e[38;5;87m"
red="\e[38;5;196m"
neutral="\e[0m"
blue="\e[38;5;130m"
yellow="\e[38;5;226m"
reset="\e[0m"

# ========== Hapus Bot Lama ==========
hapus_bot_lama() {
  echo -e "${yellow}🧹 Menghapus bot lama...${neutral}"
  systemctl stop sellvpn.service 2>/dev/null
  systemctl disable sellvpn.service 2>/dev/null
  rm -f /etc/systemd/system/sellvpn.service
  rm -f /usr/bin/sellvpn /usr/bin/server_sellvpn /etc/cron.d/server_sellvpn
  rm -rf /root/BotVPN2

  if command -v pm2 &> /dev/null; then
    pm2 delete sellvpn &> /dev/null
    pm2 save &> /dev/null
  fi

  systemctl daemon-reload
  echo -e "${green}✅ Bot lama berhasil dihapus.${neutral}"
}

# ========== Install Dependensi ==========
pasang_package() {
  echo -e "${blue}📦 Menginstall dependensi...${reset}"
  apt update -y
  apt install -y npm nodejs curl dos2unix jq tmux git \
    build-essential libcairo2-dev libpango1.0-dev libjpeg-dev \
    libgif-dev librsvg2-dev pkg-config libpixman-1-dev
  npm install -g pm2
}

# ========== Setup Bot ==========
setup_bot() {
  timedatectl set-timezone Asia/Jakarta

  echo -e "${blue}📥 Clone repository bot...${reset}"
  git clone https://github.com/mudziboy/Autobot.git /root/BotVPN2 || {
    echo -e "${red}❌ Gagal clone repo. Periksa koneksi internet atau pastikan repo publik.${neutral}"
    exit 1
  }

  echo -e "${yellow}🔧 Konversi semua script ke format Unix (LF)...${neutral}"
  find /root/BotVPN2 -type f -name "*.sh" -exec dos2unix {} \;

  echo -e "${yellow}📦 Install dependensi NPM...${neutral}"
  npm install --prefix /root/BotVPN2 sqlite3 express crypto telegraf axios dotenv node-cron

  chmod +x /root/BotVPN2/*
}

# ========== Firewall ==========
set_firewall() {
  echo -e "${yellow}🧱 Mengatur firewall...${reset}"
  ufw allow 22
  ufw allow 80
  ufw allow 443
  ufw allow 50123
  ufw --force enable
}

# ========== Jalankan Bot ==========
server_app() {
  echo -e "${green}🚀 Menjalankan bot dengan PM2...${neutral}"
  cd /root/BotVPN2 || exit 1

  if [ ! -f "app.js" ]; then
    echo -e "${red}❌ File app.js tidak ditemukan di /root/BotVPN2.${neutral}"
    exit 1
  fi

  pm2 delete sellvpn &>/dev/null
  pm2 start app.js --name sellvpn
  pm2 save
  pm2 startup
  echo -e "${green}✅ Bot berhasil dijalankan dengan PM2.${neutral}"
}

# ========== Jalankan Semua ==========
hapus_bot_lama
pasang_package
setup_bot
set_firewall
server_app